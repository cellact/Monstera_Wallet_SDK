# Copy to repo root: cp examples/nodejs/.env.example .env
# Never commit .env with real keys.

# --- Common (most examples) ---
SIGNER_PRIVATE_KEY=0x...
PASSWORD=mysecretpassword123

# --- After creating a wallet (getting-started/01-create-wallet.js) ---
WALLET_ADDRESS=0x...
MNEMONIC="word1 word2 word3 ..."

# --- Password auth ---
NEW_PASSWORD=mynewpassword123

# --- Wallet-signature auth ---
ALLOWED_1_KEY=0x...
ALLOWED_2_KEY=0x...

# --- Password-minute-signature ---
KEYVAULT_ADDRESS=0x...

# --- Accounts ---
INDEX=0
ACCOUNT_INDEX=0

# --- Signing (optional cross-chain demo in sign-transaction) ---
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
COUNTER_BYTECODE=0x...
DELEGATE_CONTRACT=0x...

# --- Wallet creation variants ---
HOOK_ADDRESS=0x...
CUSTOM_LOGIC_IMPL=0x...

# --- Upgrades (admin) ---
ADMIN_ADDRESS=0x...
NEW_LOGIC_ADDRESS=0x...
NEW_KEYVAULT_IMPL_ADDRESS=0x...
NEW_KEYVAULT_ADDRESS=0x...

# --- Factory admin ---
NEW_ADMIN_ADDRESS=0x...

# --- Authenticator management ---
NEW_AUTHENTICATOR_ADDRESS=0x...
